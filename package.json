{
  "name": "elpod",
  "version": "0.0.1",
  "private": false,
  "description": "Enterprise-friendly structure for Elysia: explicit DI, feature pods, and native controller routes.",
  "type": "module",
  "author": "Muhammad Atif <dev.muhammad.atif@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acefolioDev/elpod.git"
  },
  "homepage": "https://github.com/acefolioDev/elpod",
  "bugs": {
    "url": "https://github.com/acefolioDev/elpod/issues"
  },
  "keywords": [
    "bun",
    "elysia",
    "elysiajs",
    "elysia-framework",
    "dependency-injection",
    "pod",
    "modular-architecture",
    "typescript",
    "backend-structure"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "elpod": "dist/cli/elpod.js"
  },
  "files": [
    "dist",
    "template",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun run build:types && bun build src/kernel/index.ts --outfile dist/index.js --target bun --format esm --external elysia && bun build src/cli/elpod.ts --outfile dist/cli/elpod.js --target bun --format esm --external elysia",
    "build:types": "bunx tsc -p tsconfig.build.json",
    "typecheck": "bunx tsc --noEmit",
    "check:examples": "bun scripts/check-examples.ts",
    "check:lines": "bun scripts/check-line-limits.ts",
    "test": "bun test",
    "test:package": "bun run scripts/package-smoke.ts",
    "bench": "bun scripts/benchmark.ts",
    "check": "bun run check:lines && bun run typecheck && bun run check:examples && bun test",
    "seal": "bun run check",
    "prepack": "bun run build",
    "landing:dev": "cd ../website && bun run dev",
    "landing:build": "cd ../website && bun run build"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@types/bun": "^1.4.0",
    "bun-types": "^1.4.0",
    "typescript": "^5.9.0"
  }
}
